# ─── Banco de dados ────────────────────────────────────────────────────────────
# Neon PostgreSQL — obter em: neon.tech → Connection String
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Firebase ──────────────────────────────────────────────────────────────────
# Caminho para o JSON da service account — baixar em: Firebase Console → Configurações do Projeto → Contas de serviço
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# ─── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS="http://localhost:4200,http://localhost:4201,http://localhost:4300"

# ─── Criptografia ──────────────────────────────────────────────────────────────
# Chave AES-256-GCM: exatamente 64 caracteres hexadecimais (32 bytes)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=COLOQUE_AQUI_64_CHARS_HEX

# ─── Pagar.me ──────────────────────────────────────────────────────────────────
# Chave da API — obter em: Pagar.me Dashboard → Configurações → Dados da conta
# Prefixo sk_test_... para sandbox | sk_live_... para produção
PAGARME_API_KEY=sk_test_XXXXXXXXXXXXXXXX

PAGARME_ENVIRONMENT=sandbox

# Recipient ID da plataforma ArenaFlow para receber a comissão
PAGARME_PLATFORM_RECIPIENT_ID=re_XXXXXXXXXXXXXXXXXXXXXXXX

# Segredo para validação HMAC de webhooks — obter em: Pagar.me Dashboard → Webhooks → Segredo
# OBRIGATÓRIO em produção — sem este valor, o endpoint de webhook aceita qualquer requisição
PAGARME_WEBHOOK_SECRET=COLOQUE_AQUI_O_SEGREDO_DO_WEBHOOK

# ─── Resend (e-mail transacional) ──────────────────────────────────────────────
# Obter em: resend.com → API Keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Administrador da plataforma ───────────────────────────────────────────────
# E-mail do dono do ArenaFlow — nunca hardcoded no código
PLATFORM_ADMIN_EMAIL=seu@email.com
